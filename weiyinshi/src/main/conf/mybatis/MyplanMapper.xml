<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.daowen.mapper.MyplanMapper">


      <select id="getEntityPlus"   resultType="myplan">
                 select  p.*,
                  h.accountname as hyaccount,
                   h.name as hyname
                  from  myplan p
                  left join huiyuan h
                  on h.id=p.hyid
                  where  1=1
                  <if test="hyid!=null">
                      and hyid=#{hyid}
                  </if>
                 <if test="title!=null">
                     and title like '%${title}%'
                 </if>
      </select>
      
       <select id="loadPlus"   resultType="myplan">
                select  p.*,
                  h.accountname as hyaccount,
                   h.name as hyname
                  from  myplan p
                  left join huiyuan h
                  on h.id=p.hyid
                 where  p.id=#{id}
      </select>
      


</mapper>


