<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.daowen.mapper.SportlogMapper">


      <select id="getEntityPlus"   resultType="sportlog">
                 select  s.*,
                   h.accountname as hyaccount,
                   h.name as hyname
                  from  sportlog s
                 left join huiyuan h
                 on h.id=s.hyid
                 where  1=1
                 <if test="hyid!=null">
                     and hyid=#{hyid}
                 </if>

      </select>
      
       <select id="loadPlus"   resultType="sportlog">
                  select  s.*,
                   h.accountname as hyaccount,
                   h.name as hyname
                  from  sportlog s
                 left join huiyuan h
                 on h.id=s.hyid
                 where  s.id=#{id}
      </select>
      


</mapper>


