<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.daowen.mapper.DynamicMapper">


      <select id="getEntityPlus"   resultType="dynamic">
                 select  d.*,
                   h.accountname as hyaccount,
                   h.name as hyname
                  from  dynamic d
                 left join huiyuan h
                 on h.id=d.hyid
                 where  1=1
                 <if test="title!=null">
                     and d.title like '%${title}%'
                 </if>
                 <if test="hyid!=null">
                     and hyid=#{hyid}
                 </if>

      </select>
      
       <select id="loadPlus"   resultType="dynamic">
                 select  d.*,
                   h.accountname as hyaccount,
                   h.name as hyname
                  from  dynamic d
                 left join huiyuan h
                 on h.id=d.hyid
                 where  d.id=#{id}
      </select>
      


</mapper>


